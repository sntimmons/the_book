# Tooling-only environment example (seed scripts, DB/security tests, E2E setup).
# Copy to `.env.tooling.local` (gitignored) and fill in NON-PRODUCTION values.
#
# These variables are for PRIVATE tooling ONLY. They are NOT EXPO_PUBLIC_* and
# are NEVER bundled into the Expo app. The service-role key bypasses RLS, so it
# must never be committed and never be exposed to the client.
#
# All tooling that uses these must guard against the production ref via
# test/guards/supabaseTarget.ts (assertNotProductionSupabase).

# Non-production project the tooling targets.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=

# PRIVATE — service-role key for seed/admin operations. Never commit a real value.
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Non-production seed-account passwords (reserved identities). Never commit real values.
SEED_CLIENT_EMAIL=client@thebook.dev
SEED_PROVIDER_EMAIL=provider@thebook.dev
SEED_CLIENT_PASSWORD=
SEED_PROVIDER_PASSWORD=
