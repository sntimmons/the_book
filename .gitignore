node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files and secrets
.env*.local
.env
.env.local
.env.development
.env.production
.env.staging
.secrets
# sentry.properties is committed (placeholder token only); ignore local override
sentry.properties.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

supabase/.temp/

# Local scratch: generated audit/inspection output (e.g. tmp/f2-live-db-audit/, a live
# DB schema dump). Nothing here has ever been tracked and nothing in the app, scripts,
# CI or docs reads from it -- tooling that needs a temp file uses the system temp dir
# (os.tmpdir()), not this path. Anchored with a leading slash so it matches ONLY the
# repo-root directory, never a nested tmp/ somewhere in the source tree.
/tmp/
